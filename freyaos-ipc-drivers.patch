+; ---------------------------------------------------------------------------
+; driver.asm — a user-space driver, in miniature: one job per run.
+;
+; RDI at entry = mode. Slot 0 (PORTS) holds an I/O-port capability and
+; slot 1 (IRQ) an interrupt-line capability, for the roles given them.
+; kernel/src/irq.rs's self-test mirrors the modes.
+; ---------------------------------------------------------------------------
+bits 64
+%include "freya.inc"
+org CODE_BASE
+
+CMOS_INDEX  equ 0x70
+CMOS_DATA   equ 0x71
+RTC_SECONDS equ 0x00
+RTC_STATUS_A equ 0x0A
+KEYBOARD    equ 0x60
+
+start:
+    movzx eax, dil
+    cmp eax, (table_end - table) / 8
+    jae bad
+    lea rcx, [rel table]
+    jmp [rcx + rax*8]
+
+table:
+    dq read_clock               ; 0: read the CMOS clock's seconds
+    dq outside_range            ; 1: a port the capability doesn't cover
+    dq irq_loop                 ; 2: handle 10 interrupts on the line in slot 1
+    dq misuse                   ; 3: wrong capability kinds, bad widths
+table_end:
+
+; --- 0: the real-time clock -------------------------------------------------
+; Wait while the clock is mid-update (status A bit 7), then read seconds.
+read_clock:
+    mov r12d, 100000            ; give up eventually
+.wait:
+    mov edx, RTC_STATUS_A
+    call cmos_read
+    test eax, 0x80
+    jz .ready
+    dec r12d
+    jnz .wait
+.ready:
+    mov edx, RTC_SECONDS
+    call cmos_read
+    mov rdi, rax
+    jmp exit
+
+; cmos_read: register EDX -> value in RAX (exits on a refused port access)
+cmos_read:
+    mov r13, rdx
+    mov eax, SYS_PORT_OUT
+    mov edi, PORTS
+    mov esi, CMOS_INDEX
+    mov edx, 1
+    mov r10, r13
+    syscall
+    test rax, rax
+    jnz exit_rax
+    mov eax, SYS_PORT_IN
+    mov edi, PORTS
+    mov esi, CMOS_DATA
+    mov edx, 1
+    syscall
+    test rax, rax
+    js exit_rax
+    ret
+
+; --- 1: outside the range ---------------------------------------------------
+outside_range:
+    mov eax, SYS_PORT_IN
+    mov edi, PORTS
+    mov esi, KEYBOARD
+    mov edx, 1
+    syscall
+    jmp exit_rax                ; expect ERR_WRONG_CAPABILITY
+
+; --- 2: interrupt loop ------------------------------------------------------
+irq_loop:
+    xor r12d, r12d
+.next:
+    cmp r12d, 10
+    jae .done
+    mov eax, SYS_IRQ_WAIT
+    mov edi, IRQ
+    syscall
+    test rax, rax
+    jnz exit_rax
+    mov eax, SYS_IRQ_ACK
+    mov edi, IRQ
+    syscall
+    inc r12d
+    jmp .next
+.done:
+    mov edi, r12d
+    jmp exit
+
+; --- 3: misuse --------------------------------------------------------------
+misuse:
+    mov eax, SYS_IRQ_WAIT       ; wait on a port capability
+    mov edi, PORTS
+    syscall
+    cmp rax, ERR_WRONG_CAPABILITY
+    jne bad
+    mov eax, SYS_PORT_IN        ; port I/O through an interrupt capability
+    mov edi, IRQ
+    mov esi, CMOS_DATA
+    mov edx, 1
+    syscall
+    cmp rax, ERR_WRONG_CAPABILITY
+    jne bad
+    mov eax, SYS_PORT_IN        ; a 3-byte access
+    mov edi, PORTS
+    mov esi, CMOS_DATA
+    mov edx, 3
+    syscall
+    cmp rax, ERR_BAD_ARGUMENT
+    jne bad
+    mov eax, SYS_PORT_IN        ; 2 bytes from the last port: runs past the range
+    mov edi, PORTS
+    mov esi, CMOS_DATA
+    mov edx, 2
+    syscall
+    cmp rax, ERR_WRONG_CAPABILITY
+    jne bad
+    xor edi, edi
+    jmp exit
+
+bad:
+    mov edi, 0xBAD
+    jmp exit
+exit_rax:
+    mov rdi, rax
+exit:
+    mov eax, SYS_EXIT
+    syscall
+    ud2
diff --git a/user/freya.inc b/user/freya.inc
index 1641960..5d8b24c 100644
--- a/user/freya.inc
+++ b/user/freya.inc
@@ -12,13 +12,35 @@ STACK_TOP   equ 0x00007FFF00000000  ; RSP at entry (16 KiB of stack below)
 
 ; System calls: number in RAX, arguments in RDI, RSI, RDX, result in RAX.
 ; RCX and R11 are destroyed; every other register and the SSE state are kept.
-SYS_EXIT    equ 0                   ; exit(code): never returns
-SYS_YIELD   equ 1                   ; yield(): give up the rest of this time slice
-SYS_WRITE   equ 2                   ; write(cap, ptr, len): bytes written
+SYS_EXIT     equ 0                  ; exit(code): never returns
+SYS_YIELD    equ 1                  ; yield(): give up the rest of this time slice
+SYS_WRITE    equ 2                  ; write(cap, ptr, len): bytes written
+SYS_SEND     equ 3                  ; send(ep, w0, w1, w2, w3, xfer)
+SYS_RECV     equ 4                  ; recv(ep): badge in RDI, words in RSI RDX R10 R8, cap slot in R9
+SYS_CALL     equ 5                  ; call(ep, w0, w1, w2, w3, xfer): reply like recv
+SYS_REPLY    equ 6                  ; reply(-, w0, w1, w2, w3, xfer)
+SYS_PORT_IN  equ 7                  ; port_in(ports, port, width): value
+SYS_PORT_OUT equ 8                  ; port_out(ports, port, width, value)
+SYS_IRQ_WAIT equ 9                  ; irq_wait(irq): returns once the line has fired
+SYS_IRQ_ACK  equ 10                 ; irq_ack(irq)
 
-ERR_BAD_SYSCALL   equ -1
-ERR_NO_CAPABILITY equ -2
-ERR_BAD_ADDRESS   equ -3
+; Message words go in RSI, RDX, R10, R8; R9 = slot of a capability to pass
+; along, or NO_CAP.
+NO_CAP       equ -1
 
-; Capability slots. A process gets only what its creator hands it.
+ERR_BAD_SYSCALL      equ -1
+ERR_NO_CAPABILITY    equ -2
+ERR_BAD_ADDRESS      equ -3
+ERR_WRONG_CAPABILITY equ -4
+ERR_NO_GRANT         equ -5
+ERR_PEER_GONE        equ -6
+ERR_INTERRUPTED      equ -7
+ERR_NO_REPLY         equ -8
+ERR_BAD_ARGUMENT     equ -9
+
+; Capability slots. A process gets only what its creator hands it; the
+; kernel's tests use these slots.
 CONSOLE     equ 0                   ; the console capability, when given
+ENDPOINT    equ 1                   ; an endpoint capability, when given (ipc.asm)
+PORTS       equ 0                   ; I/O ports (driver.asm)
+IRQ         equ 1                   ; an interrupt line (driver.asm)
diff --git a/user/ipc.asm b/user/ipc.asm
new file mode 100644
index 0000000..4a3a7fa
--- /dev/null
+++ b/user/ipc.asm
@@ -0,0 +1,314 @@
+; ---------------------------------------------------------------------------
+; ipc.asm — IPC test program: one role per run.
+;
+; RDI at entry = mode | value << 8. Every role exits with a result code the
+; kernel's self-test checks (kernel/src/ipc.rs mirrors the modes). Slot 1
+; (ENDPOINT) holds the endpoint capability the kernel gave it; slot 0 the
+; console capability, for the roles that have one.
+; ---------------------------------------------------------------------------
+bits 64
+%include "freya.inc"
+org CODE_BASE
+
+QUIT equ 0xFFFF
+
+start:
+    mov rbx, rdi
+    shr rbx, 8                  ; value
+    movzx eax, dil              ; mode
+    cmp eax, (table_end - table) / 8
+    jae bad_mode
+    lea rcx, [rel table]
+    jmp [rcx + rax*8]
+
+table:
+    dq echo_server              ; 0: answer `value` calls, then exit(count)
+    dq client                   ; 1: one call; exit(badge the server saw)
+    dq pinger                   ; 2: `value` calls in a row, checking each answer
+    dq giver                    ; 3: send our console capability through slot 1
+    dq taker                    ; 4: receive a capability, print through it
+    dq wrong_caps               ; 5: misuse capabilities; exit(0) if all refused
+    dq dying_server             ; 6: take one call and end without answering
+    dq log_server               ; 7: print what clients send, for them
+    dq log_client               ; 8: no console of its own; print via the server
+    dq receiver                 ; 9: wait on slot 1 forever (to be killed)
+    dq sender                   ; 10: one plain send; exit(result)
+    dq collector                ; 11: receive `value` messages; exit(their badges, in order)
+    dq patient_server           ; 12: take a call, wait for word on slot 2, then answer
+table_end:
+
+; --- 0: echo server ---------------------------------------------------------
+; Each answer: words + 1, and the badge of the caller in word 3.
+echo_server:
+    xor r12d, r12d              ; calls answered
+.next:
+    cmp r12, rbx
+    jae .done
+    mov eax, SYS_RECV
+    mov edi, ENDPOINT
+    syscall
+    test rax, rax
+    jnz exit_rax
+    inc rsi
+    inc rdx
+    inc r10
+    mov r8, rdi                 ; the caller's badge
+    mov r9, NO_CAP
+    mov eax, SYS_REPLY
+    syscall
+    test rax, rax
+    jnz exit_rax
+    inc r12
+    jmp .next
+.done:
+    mov rdi, r12
+    jmp exit
+
+; --- 1: client --------------------------------------------------------------
+client:
+    mov eax, SYS_CALL
+    mov edi, ENDPOINT
+    mov esi, 10
+    mov edx, 20
+    mov r10d, 30
+    xor r8d, r8d
+    mov r9, NO_CAP
+    syscall
+    test rax, rax
+    jnz exit_rax                ; e.g. ERR_PEER_GONE
+    cmp rsi, 11
+    jne bad
+    cmp rdx, 21
+    jne bad
+    cmp r10, 31
+    jne bad
+    mov rdi, r8                 ; the badge the server saw: ours
+    jmp exit
+
+; --- 2: pinger --------------------------------------------------------------
+pinger:
+    xor r12d, r12d
+.next:
+    cmp r12, rbx
+    jae .done
+    mov eax, SYS_CALL
+    mov edi, ENDPOINT
+    mov rsi, r12
+    xor edx, edx
+    xor r10d, r10d
+    xor r8d, r8d
+    mov r9, NO_CAP
+    syscall
+    test rax, rax
+    jnz exit_rax
+    lea rax, [r12 + 1]
+    cmp rsi, rax                ; answered in order, each exactly once
+    jne bad
+    inc r12
+    jmp .next
+.done:
+    mov rdi, r12
+    jmp exit
+
+; --- 3: giver ---------------------------------------------------------------
+giver:
+    mov eax, SYS_SEND
+    mov edi, ENDPOINT
+    xor esi, esi
+    xor edx, edx
+    xor r10d, r10d
+    xor r8d, r8d
+    mov r9d, CONSOLE            ; pass the console capability along
+    syscall
+    jmp exit_rax
+
+; --- 4: taker ---------------------------------------------------------------
+; Born without a console; prints once one arrives in a message.
+taker:
+    mov eax, SYS_WRITE          ; first, prove we can't print yet
+    mov edi, CONSOLE
+    lea rsi, [rel given_text]
+    mov edx, given_length
+    syscall
+    cmp rax, ERR_NO_CAPABILITY
+    jne bad
+    mov eax, SYS_RECV
+    mov edi, ENDPOINT
+    syscall
+    test rax, rax
+    jnz exit_rax
+    cmp r9, NO_CAP
+    je bad
+    mov rdi, r9                 ; the slot the capability landed in
+    mov eax, SYS_WRITE
+    lea rsi, [rel given_text]
+    mov edx, given_length
+    syscall
+    jmp exit_rax                ; bytes written
+
+; --- 5: wrong capabilities --------------------------------------------------
+; Slot 1 is send-only; slot 0 is the console. Each call must be refused.
+wrong_caps:
+    mov eax, SYS_RECV           ; receive with a send-only capability
+    mov edi, ENDPOINT
+    syscall
+    cmp rax, ERR_WRONG_CAPABILITY
+    jne bad
+    mov eax, SYS_SEND           ; send through something that isn't an endpoint
+    mov edi, CONSOLE
+    mov r9, NO_CAP
+    syscall
+    cmp rax, ERR_WRONG_CAPABILITY
+    jne bad
+    mov eax, SYS_SEND           ; send through an empty slot
+    mov edi, 7
+    mov r9, NO_CAP
+    syscall
+    cmp rax, ERR_WRONG_CAPABILITY
+    jne bad
+    mov eax, SYS_REPLY          ; answer a call nobody made
+    mov r9, NO_CAP
+    syscall
+    cmp rax, ERR_NO_REPLY
+    jne bad
+    xor edi, edi
+    jmp exit
+
+; --- 6: dying server --------------------------------------------------------
+dying_server:
+    mov eax, SYS_RECV
+    mov edi, ENDPOINT
+    syscall
+    xor edi, edi
+    jmp exit                    ; the caller is still waiting for an answer
+
+; --- 7: log server ----------------------------------------------------------
+; Prints the 32 bytes each client sends (4 words), answers, repeats `value`
+; times.
+log_server:
+    xor r12d, r12d
+.next:
+    cmp r12, rbx
+    jae .done
+    mov eax, SYS_RECV
+    mov edi, ENDPOINT
+    syscall
+    test rax, rax
+    jnz exit_rax
+    mov rax, DATA_BASE
+    mov [rax], rsi
+    mov [rax + 8], rdx
+    mov [rax + 16], r10
+    mov [rax + 24], r8
+    mov eax, SYS_WRITE
+    mov edi, CONSOLE
+    mov rsi, DATA_BASE
+    mov edx, 32
+    syscall
+    mov rsi, rax                ; answer: what write returned
+    mov eax, SYS_REPLY
+    mov r9, NO_CAP
+    syscall
+    inc r12
+    jmp .next
+.done:
+    mov rdi, r12
+    jmp exit
+
+; --- 8: log client ----------------------------------------------------------
+log_client:
+    mov eax, SYS_WRITE          ; no console of our own
+    mov edi, CONSOLE
+    lea rsi, [rel log_text]
+    mov edx, 32
+    syscall
+    cmp rax, ERR_NO_CAPABILITY
+    jne bad
+    mov eax, SYS_CALL           ; so ask the server, which has one
+    mov edi, ENDPOINT
+    mov rsi, [rel log_text]
+    mov rdx, [rel log_text + 8]
+    mov r10, [rel log_text + 16]
+    mov r8, [rel log_text + 24]
+    mov r9, NO_CAP
+    syscall
+    test rax, rax
+    jnz exit_rax
+    mov rdi, rsi                ; bytes the server printed for us
+    jmp exit
+
+; --- 9: receiver ------------------------------------------------------------
+receiver:
+    mov eax, SYS_RECV
+    mov edi, ENDPOINT
+    syscall
+    jmp exit_rax                ; only reached if killed... which never returns
+
+; --- 10: sender -------------------------------------------------------------
+sender:
+    mov eax, SYS_SEND
+    mov edi, ENDPOINT
+    xor esi, esi
+    xor edx, edx
+    xor r10d, r10d
+    xor r8d, r8d
+    mov r9, NO_CAP
+    syscall
+    jmp exit_rax
+
+; --- 11: collector ----------------------------------------------------------
+; Receives `value` messages and exits with their badges' low bytes packed
+; first-to-last: badges 1, 2, 3 in that order give 0x010203.
+collector:
+    xor r12d, r12d              ; messages so far
+    xor r13d, r13d              ; packed badges
+.next:
+    cmp r12, rbx
+    jae .done
+    mov eax, SYS_RECV
+    mov edi, ENDPOINT
+    syscall
+    test rax, rax
+    jnz exit_rax
+    shl r13, 8
+    movzx edi, dil
+    or r13, rdi
+    inc r12
+    jmp .next
+.done:
+    mov rdi, r13
+    jmp exit
+
+; --- 12: patient server ----------------------------------------------------
+; Takes a call on slot 1, then waits for a plain message on slot 2 before
+; answering, so the kernel can kill the caller in between. exit(reply result).
+patient_server:
+    mov eax, SYS_RECV
+    mov edi, ENDPOINT
+    syscall
+    test rax, rax
+    jnz exit_rax
+    mov eax, SYS_RECV
+    mov edi, 2
+    syscall
+    test rax, rax
+    jnz exit_rax
+    mov eax, SYS_REPLY
+    mov r9, NO_CAP
+    syscall
+    jmp exit_rax                ; ERR_PEER_GONE if the caller is gone
+
+bad_mode:
+bad:
+    mov edi, 0xBAD
+    jmp exit
+exit_rax:
+    mov rdi, rax
+exit:
+    mov eax, SYS_EXIT
+    syscall
+    ud2
+
+given_text:     db "I was given the console in a message", 10
+given_length    equ $ - given_text
+log_text:       db "printed for me by the log server"     ; exactly 32 bytes
